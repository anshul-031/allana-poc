# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/allana_portal?schema=public"

# Cloudflare R2 / S3 Storage Credentials
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="allana-export-portal"

# Application Secrets & URLs
JWT_SECRET="super-secret-jwt-key-replace-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
